---
import LayoutA from '../layouts/LayoutA.astro';
import { Stack } from '../components/ui';
---

<LayoutA
	title="Design engineering for ambitious B2B software • Amoeba"
	description="Amoeba is a design engineering studio for ambitious B2B software companies. Rent a design engineer to ship polished UI as pull requests for your team to review."
	mastheadIsH1
>
	<Stack space="4">
		<Stack space="1" class="intro">
			<h2><a href="/rent-a-design-engineer">Rent a design engineer</a></h2>
			<p>Is your app rough around the edges? Are you looking to buff out the AI slop from your interface? Populate a backlog of issues and I’ll ship polished UI as PRs for your engineering team to review.</p>
			<p class="type-display price">$500 / week</p>
		</Stack>
