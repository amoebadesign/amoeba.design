---
import LayoutA from '../layouts/LayoutA.astro';
import ContactForm from '../components/ContactForm.astro';
import { Stack } from '../components/ui';

const title = 'Contact • Amoeba';
const description =
	'Get in touch with Amoeba about product design and design engineering work.';
const pageUrl = 'https://amoeba.design/contact';
const sent = Astro.url.searchParams.has('sent');

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://amoeba.design/' },
		{ '@type': 'ListItem', position: 2, name: 'Contact', item: pageUrl },
	],
};
---

<LayoutA title={title} description={description} jsonLd={jsonLd}>
	<Stack space="8" class="copy">
		<Stack space="3">
			<h1 class="type-title-alt">Contact</h1>
			<p>Have a project or a question? Send a note and I'll get back to you.</p>
		</Stack>

		<Stack space="3" class="contact-form-shell">
			<h2>Message</h2>
			<ContactForm returnTo="/contact" sent={sent} />
		</Stack>
	</Stack>
</LayoutA>

<style>
	.copy {
		max-inline-size: var(--measure);
	}

	h1 {
		letter-spacing: var(--tracking-tight);
	}
</style>
