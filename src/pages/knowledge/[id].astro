---
import LayoutA from '../../layouts/LayoutA.astro';
import { Stack } from '../../components/ui';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
	const pages = await getCollection('knowledge');
	return pages.map((page) => ({
		params: { id: page.id },
		props: { page },
	}));
}

interface Props {
	page: CollectionEntry<'knowledge'>;
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<LayoutA title={`${page.data.title} | Amoeba Design`} noindex={page.data.noindex}>
	<Stack as="article" space="4" class="article">
		<h1 class="type-title-alt">{page.data.title}</h1>
		<Content />
	</Stack>
</LayoutA>

<style>
	.article {
		max-inline-size: var(--measure);
	}
</style>
