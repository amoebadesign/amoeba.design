---
import LayoutA from '../../layouts/LayoutA.astro';
import { Stack } from '../../components/ui';
import { getCollection } from 'astro:content';

const pages = (await getCollection('knowledge')).sort((a, b) =>
	a.data.title.localeCompare(b.data.title),
);
---

<LayoutA
	title="Design engineering knowledge • Amoeba"
	description="Knowledge from Amoeba on design engineering for ambitious B2B software: CSS, Tailwind, native HTML, Figma, Storybook, shadcn/lint, and fixing AI slop in the UI."
	heading="Knowledge"
>
	<Stack space="8">
		<Stack as="ul" role="list" space="4">
			{pages.map((page) => (
				<Stack as="li" space="1">
					<h2 class="entry-title">
						<a href={`/knowledge/${page.id}`}>{page.data.title}</a>
					</h2>
					<p>{page.data.description}</p>
				</Stack>
			))}
		</Stack>
		<Stack space="2">
			<p class="type-caption">Also</p>
			<Stack as="ul" role="list" space="1">
				<li><a href="/rent-a-design-engineer">Rent a design engineer</a></li>
				<li><a href="/compare/design-engineer-vs-product-designer-vs-frontend-engineer">Design engineer vs product designer vs frontend engineer</a></li>
				<li><a href="/compare/rent-a-design-engineer-vs-hiring">Rent a design engineer vs hiring</a></li>
				<li><a href="/tools/ui-polish-checklist">UI polish checklist</a></li>
			</Stack>
		</Stack>
	</Stack>
</LayoutA>

<style>
	.entry-title {
		font-weight: normal;
		font-size: 20px;
		letter-spacing: var(--tracking-tight);
		line-height: 100%;
	}
</style>
