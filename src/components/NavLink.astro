---
import { isActive } from "./nav-items";

interface Props {
	href: string;
	label: string;
}

const { href, label } = Astro.props;

const active = isActive(Astro.url.pathname, href);
---

<a href={href} data-text={label} class:list={{ active }}>{label}</a>

<style>
	a {
		display: inline-flex;
		flex-direction: column;
		align-items: flex-start;
		white-space: nowrap;
		text-decoration: none;
		transition: opacity 150ms ease-out;
	}

	a::before {
		content: attr(data-text);
		font-weight: 600;
		height: 0;
		min-height: 0;
		overflow: hidden;
		visibility: hidden;
		user-select: none;
	}

	a:hover,
	a:focus,
	a:active {
		text-decoration: none;
	}

	a:hover {
		opacity: 0.5;
	}

	a.active {
		font-weight: 600;
	}
</style>
