---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import { Button, Cluster, Stack } from "./ui";

interface Props {
	items: { src: ImageMetadata; alt: string }[];
	label?: string;
}

const { items, label = "Screenshots" } = Astro.props;

const WIDTHS = [1200, 1600, 2400, 3200];

const data = await Promise.all(
	items.map(async ({ src, alt }) => {
		const image = await getImage({ src, widths: [...WIDTHS.filter((width) => width < src.width), src.width] });
		return { src: image.src, srcset: image.srcSet.attribute, width: src.width, height: src.height, alt };
	}),
);

const json = JSON.stringify(data).replace(/</g, "\\u003c");
---
<dialog class="lightbox" aria-label={label} data-lightbox>
	<script is:inline type="application/json" data-lightbox-items set:html={json}></script>
	<Stack space="4" class="lightbox-body">
		<Cluster justify="end">
			<Button variant="secondary" data-lightbox-close>Close</Button>
		</Cluster>
		<figure class="lightbox-figure">
			<img class="lightbox-image" alt="" sizes="100vw" decoding="async" data-lightbox-image />
			<Stack as="figcaption" space="1" align="center" aria-live="polite" aria-atomic="true">
				<span class="type-body" data-lightbox-caption></span>
				<span class="type-caption lightbox-counter" data-lightbox-counter></span>
			</Stack>
		</figure>
		<Cluster justify="between">
			<Button variant="secondary" data-lightbox-prev><span aria-hidden="true">&larr;</span> Previous</Button>
			<Button variant="secondary" data-lightbox-next>Next <span aria-hidden="true">&rarr;</span></Button>
		</Cluster>
	</Stack>
</dialog>

<script>
	type Item = { src: string; srcset: string; width: number; height: number; alt: string };

	const SWIPE_DISTANCE = 48;
	const CLICK_AFTER_SWIPE_MS = 400;

	let dialog: HTMLDialogElement | null = null;
	let items: Item[] = [];
	let index = 0;
	let opener: HTMLElement | null = null;
	let swipe: { id: number; x: number; y: number } | null = null;
	let swipedAt = 0;

	function preload(item: Item) {
		const image = new Image();
		image.sizes = "100vw";
		image.srcset = item.srcset;
		image.src = item.src;
	}

	function show(next: number) {
		if (!dialog || items.length === 0) return;
		index = (next + items.length) % items.length;
		const item = items[index];
		const image = dialog.querySelector<HTMLImageElement>("[data-lightbox-image]")!;
		image.width = item.width;
		image.height = item.height;
		image.alt = item.alt;
		image.srcset = item.srcset;
		image.src = item.src;
		dialog.querySelector("[data-lightbox-caption]")!.textContent = item.alt;
		dialog.querySelector("[data-lightbox-counter]")!.textContent = `${index + 1} of ${items.length}`;
		if (items.length > 1) {
			preload(items[(index + 1) % items.length]);
			preload(items[(index - 1 + items.length) % items.length]);
		}
	}

	function open(trigger: HTMLElement) {
		if (!dialog || dialog.open) return;
		opener = trigger;
		show(Number(trigger.dataset.lightboxOpen));
		dialog.showModal();
	}

	function setup() {
		dialog = document.querySelector<HTMLDialogElement>("[data-lightbox]");
		if (!dialog) return;
		const lightbox = dialog;
		items = JSON.parse(lightbox.querySelector("[data-lightbox-items]")?.textContent ?? "[]");

		lightbox.querySelector("[data-lightbox-close]")?.addEventListener("click", () => lightbox.close());
		lightbox.querySelector("[data-lightbox-prev]")?.addEventListener("click", () => show(index - 1));
		lightbox.querySelector("[data-lightbox-next]")?.addEventListener("click", () => show(index + 1));

		lightbox.addEventListener("keydown", (event) => {
			if (event.key === "ArrowLeft") show(index - 1);
			else if (event.key === "ArrowRight") show(index + 1);
			else return;
			event.preventDefault();
		});

		// The dialog fills the viewport, so a tap on anything but the image, caption, or a control is a backdrop tap.
		lightbox.addEventListener("click", (event) => {
			if (performance.now() - swipedAt < CLICK_AFTER_SWIPE_MS) return;
			if (event.target instanceof Element && event.target.closest("img, button, figcaption")) return;
			lightbox.close();
		});

		lightbox.addEventListener("pointerdown", (event) => {
			swipe = event.pointerType !== "mouse" && event.isPrimary
				? { id: event.pointerId, x: event.clientX, y: event.clientY }
				: null;
		});
		lightbox.addEventListener("pointercancel", () => (swipe = null));
		lightbox.addEventListener("pointerup", (event) => {
			if (!swipe || event.pointerId !== swipe.id) return;
			const dx = event.clientX - swipe.x;
			const dy = event.clientY - swipe.y;
			swipe = null;
			// Panning a pinch-zoomed page shouldn't change the image.
			if ((window.visualViewport?.scale ?? 1) > 1.01) return;
			if (Math.abs(dx) < SWIPE_DISTANCE || Math.abs(dx) < Math.abs(dy) * 1.5) return;
			swipedAt = performance.now();
			show(index + (dx < 0 ? 1 : -1));
		});

		lightbox.addEventListener("close", () => {
			opener?.focus();
			opener = null;
		});
	}

	document.addEventListener("click", (event) => {
		const trigger = event.target instanceof Element ? event.target.closest<HTMLElement>("[data-lightbox-open]") : null;
		if (trigger) open(trigger);
	});

	document.addEventListener("astro:before-preparation", () => dialog?.close());
	document.addEventListener("astro:page-load", setup);
</script>

<style>
	:global(html:has(.lightbox[open])) {
		overflow: hidden;
		scrollbar-gutter: stable;
	}

	.lightbox {
		inline-size: 100%;
		block-size: 100%;
		max-inline-size: none;
		max-block-size: none;
		margin: 0;
		padding: 0;
		border: 0;
		background-color: color-mix(in oklch, var(--color-bg) 92%, transparent);
		-webkit-backdrop-filter: blur(16px);
		backdrop-filter: blur(16px);
		color: var(--color-fg);
		overflow: hidden;
		overscroll-behavior: contain;
		touch-action: pan-y pinch-zoom;
	}

	.lightbox[open] {
		animation: lightbox-in var(--duration-base) var(--ease-out);
	}

	.lightbox::backdrop {
		background: none;
	}

	@keyframes lightbox-in {
		from {
			opacity: 0;
		}
	}

	.lightbox-body {
		block-size: 100%;
		padding: max(var(--chrome-inset), env(safe-area-inset-top)) max(var(--chrome-inset), env(safe-area-inset-right))
			max(var(--chrome-inset), env(safe-area-inset-bottom)) max(var(--chrome-inset), env(safe-area-inset-left));
	}

	/* The image row takes whatever height the controls leave, and the image fits inside it at its own ratio. */
	.lightbox-figure {
		flex: 1;
		min-block-size: 0;
		margin: 0;
		display: grid;
		grid-template-rows: minmax(0, 1fr) auto;
		place-items: center;
		gap: calc(var(--spacing) * 3);
	}

	.lightbox-image {
		inline-size: auto;
		block-size: auto;
		max-inline-size: 100%;
		max-block-size: 100%;
		border-radius: var(--radius-md);
		user-select: none;
		-webkit-user-drag: none;
	}

	.lightbox-counter {
		color: var(--color-fg-muted);
	}

	.lightbox :global(.button) {
		min-block-size: calc(var(--spacing) * 11);
	}
</style>
