---
import type { HTMLTag, Polymorphic } from "astro/types";
import { type Align, type Justify, type Spacing, alignMap, justifyMap, layoutStyle, toSpace } from "./layout";

type Props<Tag extends HTMLTag = "div"> = Polymorphic<{ as: Tag }> & {
	space?: Spacing;
	justify?: Justify;
	align?: Align;
};

const { as: Tag = "div", space, justify, align, class: className, style, ...rest } = Astro.props;
---
<Tag
	class:list={["layout-cluster", className]}
	style={layoutStyle(
		{
			"--space": space && toSpace(space),
			"--justify": justify && justifyMap[justify],
			"--align": align && alignMap[align],
		},
		style,
	)}
	{...rest}
><slot /></Tag>
