---
import type { HTMLAttributes } from "astro/types";

type Variant = "primary" | "secondary" | "ghost";

type Props = { variant?: Variant } & (
	| ({ href: string } & HTMLAttributes<"a">)
	| ({ href?: never } & HTMLAttributes<"button">)
);

const { variant = "primary", class: className, href, ...rest } = Astro.props;
---
{
	href ? (
		<a href={href} class:list={["button", className]} data-variant={variant} {...(rest as HTMLAttributes<"a">)}><slot /></a>
	) : (
		<button type="button" class:list={["button", className]} data-variant={variant} {...(rest as HTMLAttributes<"button">)}><slot /></button>
	)
}
