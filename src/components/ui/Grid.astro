---
import type { HTMLTag, Polymorphic } from "astro/types";
import { type Length, type Spacing, layoutStyle, toLength, toSpace } from "./layout";

type Props<Tag extends HTMLTag = "div"> = Polymorphic<{ as: Tag }> & {
	space?: Spacing;
	min?: Length;
};

const { as: Tag = "div", space, min, class: className, style, ...rest } = Astro.props;
---
<Tag
	class:list={["layout-grid", className]}
	style={layoutStyle({ "--space": space && toSpace(space), "--min": min && toLength(min) }, style)}
	{...rest}
><slot /></Tag>
