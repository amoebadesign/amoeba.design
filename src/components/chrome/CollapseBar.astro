---
import { navItems, isActive } from "../nav-items";
---
<header class="collapse-bar">
	<span class="collapse-bg" aria-hidden="true"></span>
	<a class="collapse-logotype logotype" href="/">Amoeba</a>
	<nav class="collapse-nav">
		{navItems.map((item) => (
			<a href={item.href} class:list={{ active: isActive(Astro.url.pathname, item.href) }}>{item.label}</a>
		))}
	</nav>
</header>

<script>
	const root = document.documentElement;
	const range = { start: 0, end: 100 };
	let ticking = false;

	const docTop = (element: HTMLElement) => {
		let top = 0;
		let node: HTMLElement | null = element;
		while (node) {
			top += node.offsetTop;
			node = node.offsetParent as HTMLElement | null;
		}
		return top;
	};

	const update = () => {
		ticking = false;
		const bar = document.querySelector<HTMLElement>(".collapse-bar");
		if (!bar) return;
		const y = Math.max(0, window.scrollY);
		const value = Math.min(1, Math.max(0, (y - range.start) / Math.max(1, range.end - range.start)));
		root.style.setProperty("--collapse", value.toFixed(3));
		const collapsed = value > 0.5;
		if (collapsed !== root.hasAttribute("data-collapsed")) root.toggleAttribute("data-collapsed", collapsed);
		const hidden = root.dataset.chrome === "collapse" && !collapsed;
		bar.inert = hidden;
		if (hidden) bar.setAttribute("aria-hidden", "true");
		else bar.removeAttribute("aria-hidden");
	};

	// One range, measured from the wordmark passing under the bar, drives every part at once.
	const measure = () => {
		const wordmark = document.querySelector<HTMLElement>(".split-brand .logotype");
		const bar = document.querySelector<HTMLElement>(".collapse-bar");
		if (!wordmark || !bar) return;
		const barHeight = bar.offsetHeight || 52;
		const top = docTop(wordmark);
		range.start = Math.max(0, top - barHeight / 2);
		range.end = Math.max(range.start + 1, top + wordmark.offsetHeight - barHeight / 2);
		update();
	};

	window.addEventListener("scroll", () => {
		if (ticking) return;
		ticking = true;
		requestAnimationFrame(update);
	}, { passive: true });
	window.addEventListener("resize", measure);
	document.addEventListener("astro:page-load", measure);
	document.addEventListener("chrome:change", measure);
	document.fonts?.ready.then(measure);
</script>

<style>
	.collapse-bar {
		display: none;
	}

	/* --collapse defaults to 0, so if the script never runs the page shows its expanded state. */
	@media (max-width: 44.25rem) {
		:global(html:is([data-chrome="collapse"], [data-chrome="collapse-top"])) .collapse-bar {
			position: fixed;
			inset: 0 0 auto;
			z-index: 10;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 1rem;
			height: calc(52px + env(safe-area-inset-top, 0px));
			padding: env(safe-area-inset-top, 0px) var(--chrome-inset) 0;
			pointer-events: none;
		}

		.collapse-bg {
			position: absolute;
			inset: 0;
			z-index: -1;
			background: rgb(255 255 255 / 0.86);
			-webkit-backdrop-filter: blur(16px) saturate(1.6);
			backdrop-filter: blur(16px) saturate(1.6);
			box-shadow: 0 1px 0 rgb(0 0 0 / 0.08);
			opacity: var(--collapse, 0);
		}

		.collapse-logotype {
			--logotype-fit: 0.24;
			opacity: var(--collapse, 0);
			translate: 0 calc((1 - var(--collapse, 0)) * 40%);
		}

		.collapse-nav {
			display: flex;
			gap: 0.875rem;
			margin-left: auto;
			font-size: 15px;
		}

		.collapse-bar a {
			color: inherit;
			text-decoration: none;
			-webkit-tap-highlight-color: transparent;
		}

		.collapse-nav a.active {
			font-weight: 600;
		}

		:global(html:is([data-chrome="collapse"], [data-chrome="collapse-top"])[data-collapsed]) .collapse-logotype {
			pointer-events: auto;
		}

		:global(html:is([data-chrome="collapse"], [data-chrome="collapse-top"]) .split-brand .logotype) {
			opacity: calc(1 - var(--collapse, 0));
		}

		/* Nav below the tagline: the bar's links swap in for the inline row on the same progress. */
		:global(html[data-chrome="collapse"]) .collapse-nav {
			opacity: var(--collapse, 0);
			translate: 0 calc((1 - var(--collapse, 0)) * 40%);
		}

		:global(html[data-chrome="collapse"][data-collapsed]) .collapse-nav {
			pointer-events: auto;
		}

		:global(html[data-chrome="collapse"] .split-nav) {
			opacity: calc(1 - var(--collapse, 0));
		}

		/* Nav on top: the links live in the bar from the start and never move. */
		:global(html[data-chrome="collapse-top"]) .collapse-nav {
			pointer-events: auto;
		}

		:global(html[data-chrome="collapse-top"] body) {
			padding-top: calc(var(--chrome-inset) + 52px + env(safe-area-inset-top, 0px));
		}

		:global(html[data-chrome="collapse-top"] .split-nav) {
			display: none;
		}
	}
</style>
