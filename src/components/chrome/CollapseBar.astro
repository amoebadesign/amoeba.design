---
import { navItems, isActive } from "../nav-items";
---
<header class="collapse-bar" aria-hidden="true" inert>
	<a class="collapse-logotype logotype" href="/">Amoeba</a>
	<nav class="collapse-nav">
		{navItems.map((item) => (
			<a href={item.href} class:list={{ active: isActive(Astro.url.pathname, item.href) }}>{item.label}</a>
		))}
	</nav>
</header>

<script>
	let observer: IntersectionObserver | undefined;

	const setCollapsed = (collapsed: boolean) => {
		const root = document.documentElement;
		root.toggleAttribute("data-collapsed", collapsed);
		const bar = document.querySelector<HTMLElement>(".collapse-bar");
		if (!bar) return;
		bar.inert = !collapsed;
		bar.setAttribute("aria-hidden", String(!collapsed));
	};

	const watch = () => {
		observer?.disconnect();
		const wordmark = document.querySelector(".split-brand .logotype");
		if (!wordmark) return;
		observer = new IntersectionObserver(
			([entry]) => setCollapsed(!entry.isIntersecting && entry.boundingClientRect.top < 0),
			{ rootMargin: "-52px 0px 0px 0px" },
		);
		observer.observe(wordmark);
	};

	document.addEventListener("astro:page-load", watch);
</script>

<style>
	.collapse-bar {
		display: none;
	}

	@media (max-width: 44.25rem) {
		:global(html[data-chrome="collapse"]) .collapse-bar {
			position: fixed;
			inset: 0 0 auto;
			z-index: 10;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 1rem;
			height: calc(52px + env(safe-area-inset-top, 0px));
			padding: env(safe-area-inset-top, 0px) var(--chrome-inset) 0;
			background: rgb(255 255 255 / 0.86);
			-webkit-backdrop-filter: blur(16px) saturate(1.6);
			backdrop-filter: blur(16px) saturate(1.6);
			box-shadow: 0 1px 0 rgb(0 0 0 / 0.08);
			opacity: 0;
			pointer-events: none;
			transition: opacity 180ms ease-out;
		}

		:global(html[data-chrome="collapse"][data-collapsed]) .collapse-bar {
			opacity: 1;
			pointer-events: auto;
		}

		.collapse-logotype {
			--logotype-fit: 0.24;
			translate: 0 60%;
			opacity: 0;
			transition: translate 260ms cubic-bezier(0.2, 0.8, 0.2, 1), opacity 200ms ease-out;
		}

		:global(html[data-chrome="collapse"][data-collapsed]) .collapse-logotype {
			translate: 0 0;
			opacity: 1;
		}

		.collapse-nav {
			display: flex;
			gap: 0.875rem;
			font-size: 15px;
		}

		.collapse-nav a {
			text-decoration: none;
			color: inherit;
		}

		.collapse-nav a.active {
			font-weight: 600;
		}

		@supports (animation-timeline: scroll()) {
			@media (prefers-reduced-motion: no-preference) {
				:global(html[data-chrome="collapse"] .split-brand .logotype) {
					transform-origin: 0 100%;
					animation: wordmark-collapse linear both;
					animation-timeline: scroll(root);
					animation-range: 0 110px;
				}
			}
		}
	}

	@keyframes wordmark-collapse {
		to {
			scale: 0.82;
			opacity: 0;
		}
	}
</style>
