---
import { navItems, isActive } from "../nav-items";
---
<header class="collapse-bar" aria-hidden="true" inert>
	<span class="collapse-bg" aria-hidden="true"></span>
	<a class="collapse-logotype logotype" href="/">Amoeba</a>
	<nav class="collapse-nav">
		{navItems.map((item) => (
			<a href={item.href} class:list={{ active: isActive(Astro.url.pathname, item.href) }}>{item.label}</a>
		))}
	</nav>
</header>

<script>
	const root = document.documentElement;
	const supportsTimeline = CSS.supports("animation-timeline: scroll()");
	const wordmarkRange = { start: 0, mid: 50, end: 100 };
	const navRange = { start: 160, end: 190 };
	let ticking = false;

	const docTop = (element: HTMLElement) => {
		let top = 0;
		let node: HTMLElement | null = element;
		while (node) {
			top += node.offsetTop;
			node = node.offsetParent as HTMLElement | null;
		}
		return top;
	};

	const progress = (y: number, start: number, end: number) =>
		Math.min(1, Math.max(0, (y - start) / Math.max(1, end - start)));

	const update = () => {
		ticking = false;
		const bar = document.querySelector<HTMLElement>(".collapse-bar");
		if (!bar) return;
		const y = window.scrollY;
		const navProgress = progress(y, navRange.start, navRange.end);
		if (!supportsTimeline) {
			root.style.setProperty("--collapse-wm", progress(y, wordmarkRange.start, wordmarkRange.end).toFixed(3));
			root.style.setProperty("--collapse-logo", progress(y, wordmarkRange.mid, wordmarkRange.end).toFixed(3));
			root.style.setProperty("--collapse-nav", navProgress.toFixed(3));
		}
		const collapsed = navProgress > 0.5;
		if (collapsed !== root.hasAttribute("data-collapsed")) {
			root.toggleAttribute("data-collapsed", collapsed);
			bar.inert = !collapsed;
			bar.setAttribute("aria-hidden", String(!collapsed));
		}
	};

	// Ranges are tied to where the wordmark and inline nav actually sit, so the
	// collapse tracks the finger instead of firing at an arbitrary threshold.
	const measure = () => {
		const wordmark = document.querySelector<HTMLElement>(".split-brand .logotype");
		const inlineNav = document.querySelector<HTMLElement>(".split-nav");
		const bar = document.querySelector<HTMLElement>(".collapse-bar");
		if (!wordmark || !inlineNav || !bar) return;
		const barHeight = bar.offsetHeight || 52;
		const top = docTop(wordmark);
		wordmarkRange.start = Math.max(0, top - barHeight / 2);
		wordmarkRange.end = Math.max(wordmarkRange.start + 1, top + wordmark.offsetHeight - barHeight / 2);
		wordmarkRange.mid = (wordmarkRange.start + wordmarkRange.end) / 2;
		navRange.start = Math.max(0, docTop(inlineNav) - barHeight);
		navRange.end = navRange.start + Math.max(16, inlineNav.offsetHeight);
		root.style.setProperty("--collapse-wm-start", `${wordmarkRange.start}px`);
		root.style.setProperty("--collapse-wm-mid", `${wordmarkRange.mid}px`);
		root.style.setProperty("--collapse-wm-end", `${wordmarkRange.end}px`);
		root.style.setProperty("--collapse-nav-start", `${navRange.start}px`);
		root.style.setProperty("--collapse-nav-end", `${navRange.end}px`);
		update();
	};

	window.addEventListener("scroll", () => {
		if (ticking) return;
		ticking = true;
		requestAnimationFrame(update);
	}, { passive: true });
	window.addEventListener("resize", measure);
	document.addEventListener("astro:page-load", measure);
	document.addEventListener("chrome:change", measure);
	document.fonts?.ready.then(measure);
</script>

<style>
	.collapse-bar {
		display: none;
	}

	@media (max-width: 44.25rem) {
		:global(html[data-chrome="collapse"]) {
			--collapse-wm-start: 0px;
			--collapse-wm-mid: 50px;
			--collapse-wm-end: 100px;
			--collapse-nav-start: 160px;
			--collapse-nav-end: 190px;
		}

		:global(html[data-chrome="collapse"]) .collapse-bar {
			position: fixed;
			inset: 0 0 auto;
			z-index: 10;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 1rem;
			height: calc(52px + env(safe-area-inset-top, 0px));
			padding: env(safe-area-inset-top, 0px) var(--chrome-inset) 0;
			pointer-events: none;
		}

		:global(html[data-chrome="collapse"][data-collapsed]) .collapse-bar > a,
		:global(html[data-chrome="collapse"][data-collapsed]) .collapse-nav {
			pointer-events: auto;
		}

		.collapse-bg {
			position: absolute;
			inset: 0;
			z-index: -1;
			background: rgb(255 255 255 / 0.86);
			-webkit-backdrop-filter: blur(16px) saturate(1.6);
			backdrop-filter: blur(16px) saturate(1.6);
			box-shadow: 0 1px 0 rgb(0 0 0 / 0.08);
		}

		.collapse-logotype {
			--logotype-fit: 0.24;
		}

		.collapse-nav {
			display: flex;
			gap: 0.875rem;
			font-size: 15px;
		}

		.collapse-bar a {
			color: inherit;
			text-decoration: none;
			-webkit-tap-highlight-color: transparent;
		}

		.collapse-nav a.active {
			font-weight: 600;
		}

		:global(html[data-chrome="collapse"] .split-brand .logotype) {
			transform-origin: 0 100%;
		}

		@supports (animation-timeline: scroll()) {
			:global(html[data-chrome="collapse"]) .collapse-bg {
				animation: collapse-fade-in linear both;
				animation-timeline: scroll(root);
				animation-range: var(--collapse-wm-start) var(--collapse-wm-end);
			}

			:global(html[data-chrome="collapse"]) .collapse-logotype {
				animation: collapse-rise-in linear both;
				animation-timeline: scroll(root);
				animation-range: var(--collapse-wm-mid) var(--collapse-wm-end);
			}

			:global(html[data-chrome="collapse"]) .collapse-nav {
				animation: collapse-rise-in linear both;
				animation-timeline: scroll(root);
				animation-range: var(--collapse-nav-start) var(--collapse-nav-end);
			}

			:global(html[data-chrome="collapse"] .split-brand .logotype) {
				animation: collapse-wordmark-out linear both;
				animation-timeline: scroll(root);
				animation-range: var(--collapse-wm-start) var(--collapse-wm-end);
			}

			:global(html[data-chrome="collapse"] .split-nav) {
				animation: collapse-fade-out linear both;
				animation-timeline: scroll(root);
				animation-range: var(--collapse-nav-start) var(--collapse-nav-end);
			}
		}

		@supports not (animation-timeline: scroll()) {
			:global(html[data-chrome="collapse"]) .collapse-bg {
				opacity: var(--collapse-wm, 0);
			}

			:global(html[data-chrome="collapse"]) .collapse-logotype {
				opacity: var(--collapse-logo, 0);
				translate: 0 calc((1 - var(--collapse-logo, 0)) * 40%);
			}

			:global(html[data-chrome="collapse"]) .collapse-nav {
				opacity: var(--collapse-nav, 0);
				translate: 0 calc((1 - var(--collapse-nav, 0)) * 40%);
			}

			:global(html[data-chrome="collapse"] .split-brand .logotype) {
				opacity: calc(1 - var(--collapse-wm, 0));
				scale: calc(1 - 0.14 * var(--collapse-wm, 0));
			}

			:global(html[data-chrome="collapse"] .split-nav) {
				opacity: calc(1 - var(--collapse-nav, 0));
			}
		}
	}

	@keyframes collapse-fade-in {
		from {
			opacity: 0;
		}
	}

	@keyframes collapse-fade-out {
		to {
			opacity: 0;
		}
	}

	@keyframes collapse-rise-in {
		from {
			opacity: 0;
			translate: 0 40%;
		}
	}

	@keyframes collapse-wordmark-out {
		to {
			opacity: 0;
			scale: 0.86;
		}
	}
</style>
