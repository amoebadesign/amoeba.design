---
import { jigEnabled, shipsChrome } from "./chromes";
import CollapseBar from "./CollapseBar.astro";
import PillBar from "./PillBar.astro";
import OverlayMenu from "./OverlayMenu.astro";
import BottomSheet from "./BottomSheet.astro";
import ChromeJig from "./ChromeJig.astro";
---
{shipsChrome("collapse") && <CollapseBar />}
{shipsChrome("pill") && <PillBar />}
{shipsChrome("overlay") && <OverlayMenu />}
{shipsChrome("sheet") && <BottomSheet />}
{jigEnabled && <ChromeJig />}
