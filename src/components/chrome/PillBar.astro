---
import { navItems, isActive } from "../nav-items";
---
<nav class="pill" aria-label="Primary" transition:name="pill">
	{navItems.map((item) => {
		const active = isActive(Astro.url.pathname, item.href);
		return (
			<a href={item.href} class:list={{ active }} aria-current={active ? "page" : undefined}>
				{active && <span class="pill-indicator" transition:name="pill-indicator" />}
				{item.label}
			</a>
		);
	})}
</nav>

<style>
	.pill {
		display: none;
	}

	@media (max-width: 44.25rem) {
		:global(html[data-chrome="pill"] body) {
			padding-bottom: calc(var(--chrome-inset) + 76px + env(safe-area-inset-bottom, 0px));
		}

		/* Centred with auto margins rather than translate(-50%) so the bar never lands on a half pixel. */
		:global(html[data-chrome="pill"]) .pill {
			position: fixed;
			inset: auto 0 calc(14px + env(safe-area-inset-bottom, 0px));
			z-index: 10;
			display: flex;
			gap: 2px;
			width: max-content;
			margin-inline: auto;
			padding: 4px;
			border-radius: 999px;
			background: rgb(255 255 255 / 0.72);
			-webkit-backdrop-filter: blur(20px) saturate(1.8);
			backdrop-filter: blur(20px) saturate(1.8);
			box-shadow:
				0 0 0 0.5px rgb(0 0 0 / 0.14),
				0 10px 30px rgb(0 0 0 / 0.14);
		}

		.pill a {
			position: relative;
			isolation: isolate;
			display: inline-flex;
			align-items: center;
			min-height: 40px;
			padding: 0 14px;
			border-radius: 999px;
			font-size: 15px;
			line-height: 1;
			color: rgb(0 0 0 / 0.6);
			text-decoration: none;
			-webkit-tap-highlight-color: transparent;
			transition: scale 120ms ease-out;
		}

		.pill a:active {
			scale: 0.96;
		}

		.pill a.active {
			color: #000;
		}

		/* A light indicator keeps label colours identical on both sides of a view transition. */
		.pill-indicator {
			position: absolute;
			inset: 0;
			z-index: -1;
			border-radius: inherit;
			background: rgb(0 0 0 / 0.08);
		}
	}

	:global(::view-transition-group(pill-indicator)) {
		animation-duration: 320ms;
		animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
	}
</style>
