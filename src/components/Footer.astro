---
const links = [
	{ href: "http://amoebaunlimited.com", label: "Blog" },
	{ href: "https://twitter.com/amoeba_design", label: "Twitter" },
	{ href: "https://www.linkedin.com/in/bpking15", label: "Linkedin" },
	{ href: "https://www.youtube.com/@bpking15", label: "Youtube" },
] as const;
---
<footer>
	<nav class="cluster tighter" aria-label="Elsewhere">
		{links.map((link) => (
			<a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
		))}
	</nav>
</footer>

<style>
	a {
		font-size: 16px;
		font-weight: 500;
		line-height: 1;
		letter-spacing: -0.03em;
		text-decoration: none;
		text-box-trim: trim-both;
		text-box-edge: cap alphabetic;
	}
</style>
