---
import { fade } from "astro:transitions";
import Base from "./Base.astro";
import Masthead from "../components/Masthead.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import CollapseBar from "../components/CollapseBar.astro";
import { Stack } from "../components/ui";

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
	ogType?: "website" | "article";
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	/** The masthead sentence is the H1 on the homepage only. */
	mastheadIsH1?: boolean;
	/**
	 * Visually hidden page H1 for routes whose design has no title.
	 * Omit when the slot already contains the only H1.
	 */
	heading?: string;
}

const { title, description, noindex = false, ogType = "website", jsonLd, mastheadIsH1 = false, heading } = Astro.props;
---
<Base title={title} description={description} noindex={noindex} ogType={ogType} jsonLd={jsonLd}>
	<div class="split">
		<header class="split-header">
			<div class="split-brand">
				<Masthead as={mastheadIsH1 ? "h1" : "p"} />
			</div>
			<div class="split-nav" transition:name="nav">
				<Nav />
			</div>
		</header>
		<div class="split-body">
			<Stack as="main" space="4" class="split-main" transition:name="content" transition:animate={fade({ duration: "220ms" })}>
				{heading && <h1 class="page-heading">{heading}</h1>}
				<slot />
			</Stack>
			<div class="split-rail" transition:persist="rail">
				<div class="split-sizer" aria-hidden="true">
					<span class="type-logotype">Amoeba</span>
				</div>
				<Footer />
			</div>
		</div>
	</div>
	<CollapseBar />
</Base>

<style is:global>
	:root {
		--chrome-inset: 1rem;
		--split-gap: 1.25rem;
		--split-min: 20.5rem;
		--logotype-min-width: 326.2265625px;
	}

	body {
		min-height: 100dvh;
		padding: var(--chrome-inset);
	}
</style>

<style>
	/*
	  Split chrome invariants:
	  - split-header is display:contents so brand + nav wrap as .split flex items
	    with the same 50% basis as split-body.
	  - split-sizer is a hidden logotype so the rail’s min-content matches the
	    masthead glyph and they wrap together.
	  - split-body is row-reverse so the rail sits left of main in two columns;
	    DOM order stays main then footer after wrap.
	  - Brand sticks while .split is two columns; the container query unsticks
	    it after wrap. Footer unsticks intrinsically when the rail is short.
	*/
	.split {
		--logotype-fit: min(1, calc((100dvw - 2 * var(--chrome-inset)) / var(--logotype-min-width)));
		display: flex;
		flex-wrap: wrap;
		gap: var(--split-gap);
		align-items: start;
		align-content: space-between;
		container-type: inline-size;
	}

	.split-header {
		display: contents;
	}

	.split > :global(*),
	.split-header > * {
		flex: 1 1 calc(50% - var(--split-gap) / 2);
		min-width: min-content;
	}

	.split > .split-body {
		flex: 1 1 100%;
		display: flex;
		flex-wrap: wrap;
		flex-direction: row-reverse;
		gap: var(--split-gap);
		align-items: stretch;
		align-content: start;
	}

	.split-body > * {
		flex: 1 1 calc(50% - var(--split-gap) / 2);
		min-width: min(100%, var(--split-min));
	}

	.split-main {
		position: relative;
		min-height: calc(100dvh - 14rem);
	}

	/* Out of flow so Work and Knowledge keep their current layout. Still the page H1. */
	.page-heading {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}

	.split-rail {
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		min-width: min-content;
	}

	.split-sizer {
		height: 0;
		overflow: hidden;
		visibility: hidden;
		pointer-events: none;
	}

	.split-brand {
		position: sticky;
		top: var(--chrome-inset);
		z-index: 1;
	}

	.split-brand :global(.masthead-lede) {
		font-weight: normal;
		font-size: calc(26px * var(--logotype-fit, 1));
		letter-spacing: var(--tracking-tight);
		max-width: 451px;
		line-height: 100%;
		text-wrap: wrap;
	}

	.split-rail :global(footer) {
		position: sticky;
		bottom: var(--chrome-inset);
		z-index: 1;
		align-self: start;
	}

	@container (max-width: calc(2 * 20.5rem + 1.25rem)) {
		.split-brand {
			position: static;
		}
	}

	/* The container query above plus both body insets; CollapseBar uses the same breakpoint. */
	@media (max-width: 44.25rem) {
		.split-brand :global(.type-logotype),
		.split-nav {
			opacity: calc(1 - var(--collapse, 0));
		}
	}
</style>
