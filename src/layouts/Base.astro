---
import { ClientRouter } from "astro:transitions";
import JsonLd from "../components/JsonLd.astro";
import SiteGraph from "../components/SiteGraph.astro";
import { absoluteUrl, markdownPathname } from "../llms/urls.mjs";
import { ogPublicPath } from "../og/image-path.mjs";
import "../styles/amoeba/index.css";

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
	ogType?: "website" | "article";
	/** Absolute URL or site-relative path to a 1200×630 share image. */
	ogImage?: string;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const OG_IMAGE_ALT =
	"Amoeba — design engineering studio for ambitious B2B software companies.";

// Fallback only. Every page should pass its own title and description.
// Pattern is `{Page title} • Amoeba`, roughly 60 characters or less.
const {
	title = "Rent a design engineer, $500/wk • Amoeba",
	description = "Amoeba is a design engineering studio for ambitious B2B software. Rent a design engineer at $500/wk to ship polished UI as pull requests your team reviews.",
	noindex = false,
	ogType = "website",
	ogImage: ogImageProp,
	jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const ogImage = absoluteUrl(
	ogImageProp ? ogImageProp : ogPublicPath(canonical.pathname),
	canonical,
);
// Markdown alternates are generated for indexable pages only. vercel.json
// sends X-Robots-Tag: noindex for `*.md`, and those URLs are not in the sitemap.
const markdownHref = noindex ? undefined : absoluteUrl(markdownPathname(canonical.pathname), canonical);
const llmsHref = absoluteUrl("/llms.txt", canonical);
const rssHref = absoluteUrl("/rss.xml", canonical);
---
<!doctype html>
<html lang="en" transition:animate="none">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical.href} />
		{markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref} />}
		<link rel="alternate" type="application/rss+xml" title="Amoeba Knowledge" href={rssHref} />
		<link rel="describedby" href={llmsHref} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical.href} />
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="Amoeba" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={OG_IMAGE_ALT} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:url" content={canonical.href} />
		<meta name="twitter:image" content={ogImage} />
		{noindex && <meta name="robots" content="noindex, follow" />}
		<SiteGraph />
		{jsonLd && <JsonLd data={jsonLd} />}
		<script is:inline>
			(() => {
				const apply = () => {
					let theme = null;
					try {
						theme = localStorage.getItem("amoeba-theme");
					} catch {}
					if (theme) document.documentElement.dataset.theme = theme;
					else delete document.documentElement.dataset.theme;
				};
				apply();
				// ClientRouter replaces <html> attributes on every navigation.
				document.addEventListener("astro:after-swap", apply);
			})();
		</script>
		<ClientRouter />
		<!-- Fathom - beautiful, simple website analytics -->
		<!-- data-spa="auto" tracks ClientRouter navigations via history.pushState. -->
		<script is:inline src="https://cdn.usefathom.com/script.js" data-site="DJDIBJEG" data-spa="auto" defer></script>
		<!-- / Fathom -->
		<link rel="preload" href="/fonts/hex-franklin-variable.woff2" as="font" type="font/woff2" crossorigin>
		<link rel="preconnect" href="https://use.typekit.net" crossorigin>
		<link rel="preload" href="/fonts/acumin-variable.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
		<noscript><link rel="stylesheet" href="/fonts/acumin-variable.css"></noscript>
	</head>
	<body>
		<slot />
	</body>
</html>
