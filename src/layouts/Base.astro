---
import { ClientRouter } from "astro:transitions";
import "../styles/amoeba/index.css";
import JsonLd from "../components/JsonLd.astro";

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
	ogType?: "website" | "article";
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

// Fallback only. Every page should pass its own title and description.
// Pattern is `{Page title} • Amoeba`, roughly 60 characters or less. No prices.
const {
	title = "Design engineering for ambitious B2B software • Amoeba",
	description = "Amoeba is a design engineering studio for ambitious B2B software companies. Rent a design engineer to ship polished UI as pull requests for your team to review.",
	noindex = false,
	ogType = "website",
	jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---
<!doctype html>
<html lang="en" transition:animate="none">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical.href} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical.href} />
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="Amoeba" />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:url" content={canonical.href} />
		<!-- TODO(og-image): no share image in this repo. public/ has robots.txt and a font file only. Do not point og:image at a work screenshot. When Bryan supplies a 1200×630 asset at public/og.png, emit og:image and twitter:image as absolute URLs on the canonical origin. -->
		{noindex && <meta name="robots" content="noindex, follow" />}
		{jsonLd && <JsonLd data={jsonLd} />}
		<script is:inline>
			(() => {
				const apply = () => {
					let theme = null;
					try {
						theme = localStorage.getItem("amoeba-theme");
					} catch {}
					if (theme) document.documentElement.dataset.theme = theme;
					else delete document.documentElement.dataset.theme;
				};
				apply();
				// ClientRouter replaces <html> attributes on every navigation.
				document.addEventListener("astro:after-swap", apply);
			})();
		</script>
		<ClientRouter />
		<!-- Fathom - beautiful, simple website analytics -->
		<!-- data-spa="auto" tracks ClientRouter navigations via history.pushState. -->
		<script is:inline src="https://cdn.usefathom.com/script.js" data-site="DJDIBJEG" data-spa="auto" defer></script>
		<!-- / Fathom -->
		<link rel="preload" href="/fonts/hex-franklin-variable.woff2" as="font" type="font/woff2" crossorigin>
		<link rel="preload" href="https://use.typekit.net/dit6fmi.css" as="style">
		<link rel="preconnect" href="https://use.typekit.net">
		<link rel="preconnect" href="https://p.typekit.net" crossorigin>
		<link rel="stylesheet" href="https://use.typekit.net/dit6fmi.css">
	</head>
	<body>
		<slot />
	</body>
</html>
