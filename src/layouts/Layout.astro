---
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import NavLink from "../components/NavLink.astro"

interface Props {
	title?: string;
}

const {
	title = "Amoeba Design | Design engineering studio for growth-stage B2B software companies",
} = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<link rel="preload" href="/fonts/hex-franklin-variable.woff2" as="font" type="font/woff2" crossorigin>
		<link rel="preload" href="https://use.typekit.net/dit6fmi.css" as="style">
		<link rel="preconnect" href="https://use.typekit.net">
		<link rel="preconnect" href="https://p.typekit.net" crossorigin>
		<link rel="stylesheet" href="https://use.typekit.net/dit6fmi.css">
		<link rel="stylesheet" href="https://amoeba-ui.vercel.app/css/amoeba-0.1.0-alpha.css">
		<link rel="stylesheet" href="/styles/logotype.css">
		<link rel="stylesheet" href="/styles/main.css">
		<style is:global>
			:root {
				--font-sans: "acumin-variable", sans-serif;
				--font-family-sans-serif: "acumin-variable", sans-serif;
			}

		</style>
	</head>
	<body>
		<div class="has-sidebar" style="padding: var(--spacer-2); min-height:100dvh; flex-wrap:wrap-reverse">
			<div class="sidebar stack looser">
				<Header class="fill"/>
				<Footer/>
			</div>
			<main class="content stack loosest">
				<nav class="cluster">
					<NavLink href="/" label="Home" />
					<NavLink href="/Work" label="Work" />
					<NavLink href="/info" label="Info" />
					<NavLink href="/knowledge" label="Knowledge" />
				</nav>
				<slot />
			</main>
		</div>
	</body>
</html>
